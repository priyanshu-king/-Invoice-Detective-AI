# Invoice Detective AI — Backend Configuration
# Copy to .env and fill in values

# App settings
APP_ENV=development
APP_SECRET_KEY=change-me-to-a-random-secret
DEBUG=true

# Database (relative paths are resolved from the project root)
DATABASE_URL=sqlite:///./invoice_detective.db
SEED_DEMO_DATA=false

# File upload
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=20
MAX_UPLOAD_COUNT=50

# Reports
REPORT_DIR=./reports

# CORS — comma-separated local Vite development origins
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174

# OCR (optional — auto-detects tesseract on PATH; set path if installed elsewhere)
TESSERACT_PATH=

# Server
HOST=127.0.0.1
PORT=8000
